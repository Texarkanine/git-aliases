st = status
co = checkout
br = branch
ci = commit
cm = commit -m
ca = commit --amend
cia = commit -a --amend
s = status -sb
last = log -1 HEAD
lgn = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset %C(blue)- %an%Creset' --abbrev-commit --date=relative
l = log --oneline --decorate --color
lol = log --graph --decorate --pretty=oneline --abbrev-commit --all
hist = log --pretty=format:"%h %ad | %s%d [%an]" --graph --date=short
